{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classroom-kit.nextbridge.example/schemas/result-card.schema.json",
  "title": "Nextbridge Classroom Result Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "programId",
    "programVersion",
    "teamCode",
    "completedAt",
    "summary",
    "evidence",
    "nextStep",
    "aiDisclosure",
    "privacyChecked"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "programId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "programVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "teamCode": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{2,20}$"
    },
    "completedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "value": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "nextStep": { "type": "string", "minLength": 1, "maxLength": 300 },
    "aiDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {
          "enum": ["not-used", "used", "not-applicable"]
        },
        "note": { "type": "string", "maxLength": 300 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "used" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "note": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      ]
    },
    "privacyChecked": { "const": true }
  }
}
